msgid "Top P"
msgstr "Top P"

#: includes/class-wln-multi-provider-ai-chat-admin.php:426
msgid ""
"Nucleus sampling threshold (0.0-1.0). Lower values make output more focused."
msgstr ""
"Порог nucleus sampling (0.0-1.0). Меньшие значения делают ответы более "
"сфокусированными."

